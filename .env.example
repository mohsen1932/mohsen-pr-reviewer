# Local PR Reviewer — copy to .env and fill in. See SPEC.md §5, §14.

# Fine-grained GitHub PAT with access to all repositories.
#   Contents: Read · Pull requests: Read and write · Metadata: Read
GITHUB_TOKEN=

# From console.anthropic.com. Set a spend limit — this app is its only consumer.
ANTHROPIC_API_KEY=

# Optional. Default: claude-sonnet-5
REVIEW_MODEL=

# Optional. low | medium | high | xhigh | max. Default: high
REVIEW_EFFORT=

# Optional. Default: ./.cache/repos
CACHE_DIR=
