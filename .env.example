# Local PR Reviewer — copy to .env and fill in. See SPEC.md §5, §14.

# Fine-grained GitHub PAT with access to all repositories.
#   Contents: Read · Pull requests: Read and write · Metadata: Read
GITHUB_TOKEN=

# From platform.openai.com. Set a spend limit — this app is its only consumer.
OPENAI_API_KEY=

# Optional. Default: gpt-5.4-mini
REVIEW_MODEL=

# Optional. minimal | low | medium | high | xhigh. Default: high
REVIEW_EFFORT=

# Optional. Default: ./.cache/repos
CACHE_DIR=
